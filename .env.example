# SpecPulse Environment Variables Example
# Copy this file to .env and fill in the actual values before running the application.

# ---------------------------------------------------------
# Security & Authentication
# ---------------------------------------------------------
# A long, random string used to sign JWT tokens. (e.g., run `openssl rand -hex 32`)
SECRET_KEY=""

# Enforce HTTPS redirects (set to true in production)
ENFORCE_HTTPS="false"

# ---------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------
# The connection string for SQLAlchemy
DATABASE_URL="postgresql://specpulse:${POSTGRES_PASSWORD}@localhost:5432/specpulse_db"

# The password for the PostgreSQL database (used by Docker and API)
POSTGRES_PASSWORD=""

# ---------------------------------------------------------
# Storage (MinIO / S3)
# ---------------------------------------------------------
# The URL where MinIO is running
MINIO_URL="http://localhost:9000"

# Root credentials for MinIO
MINIO_ROOT_USER=""
MINIO_ROOT_PASSWORD=""

# Access credentials for the API to connect to MinIO (Usually same as root for local dev)
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""

# ---------------------------------------------------------
# Background Worker (Celery & Redis)
# ---------------------------------------------------------
# The connection string for the Celery broker
CELERY_BROKER_URL="redis://localhost:6379/0"

# ---------------------------------------------------------
# LLM Providers (API Keys)
# ---------------------------------------------------------
# Required for extraction and taxonomy agents
GROQ_API_KEY=""

# Required for DocumentExtractorSubAgent (Gemini 1.5 Pro)
GOOGLE_API_KEY=""
